  <property name="styleSheet">
   <string notr="true">QWidget#ShowBooks {
    background-color: #171f33;
    color: #dce6ff;
    font-family: "Segoe UI";
    font-size: 10pt;
}
QLabel#lbl_title { color: #dce6ff; padding: 3px 0; }
QLabel#lbl_subtitle, QLabel#lbl_count, QLabel#lbl_page { color: #aebfe7; }
QWidget#line_header { background-color: #52658d; }
QGroupBox#gb_search_filter {
    border: 1px solid #344568;
    border-radius: 9px;
    margin-top: 8px;
    padding-top: 8px;
    color: #c8d7fa;
    font-weight: bold;
}
QGroupBox#gb_search_filter::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 0 5px;
}
QLineEdit, QComboBox {
    background-color: #263451;
    border: 1px solid #40547b;
    border-radius: 6px;
    padding: 7px 10px;
    color: #e1e9ff;
    selection-background-color: #477cff;
}
QLineEdit:focus, QComboBox:focus { border: 1px solid #6c98ff; }
QComboBox QAbstractItemView {
    background-color: #263451;
    color: #e1e9ff;
    selection-background-color: #477cff;
    border: 1px solid #40547b;
}
QPushButton {
    background-color: #263451;
    color: #e1e9ff;
    border: 1px solid #344568;
    border-radius: 7px;
    padding: 8px 14px;
}
QPushButton:hover { background-color: #344568; }
QPushButton:pressed { background-color: #1e2a43; }
QPushButton:disabled { color: #68799d; background-color: #202b42; }
QPushButton#btn_search {
    background-color: #477cff;
    border: 1px solid #477cff;
    color: white;
    font-weight: bold;
}
QPushButton#btn_search:hover { background-color: #5d8cff; }
QTableWidget#table_books {
    background-color: #171f33;
    alternate-background-color: #1b2740;
    color: #dce6ff;
    border: 1px solid #344568;
    border-radius: 8px;
    selection-background-color: #344c7c;
    selection-color: white;
    outline: 0;
}
QTableWidget#table_books::item {
    padding: 7px;
    border-bottom: 1px solid #293956;
}
QHeaderView::section {
    background-color: #263451;
    color: #c8d7fa;
    border: none;
    border-bottom: 1px solid #40547b;
    padding: 12px 8px;
    font-weight: bold;
}</string>
